{
  "name": "pi-token-usage",
  "version": "0.1.0",
  "description": "Query local Pi token usage across projects and providers",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md",
    "docs/verification.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
